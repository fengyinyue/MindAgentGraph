{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindagentgraph.dev/schema/edge.json",
  "title": "MindAgentGraph Edge",
  "type": "object",
  "required": ["id", "source", "target"],
  "properties": {
    "id": { "type": "string" },
    "source": { "type": "string" },
    "sourceHandle": { "type": "string" },
    "target": { "type": "string" },
    "targetHandle": { "type": "string" },
    "label": { "type": "string" },
    "channel": {
      "type": "object",
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" }
      }
    }
  }
}
