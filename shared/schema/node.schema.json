{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindagentgraph.dev/schema/node.json",
  "title": "MindAgentGraph Node",
  "type": "object",
  "required": ["id", "type", "title", "position", "contextMode", "data"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["prompt", "planning", "subgraph", "memory", "filescope", "analysis", "code", "api", "asset", "agent", "task", "semantic"]
    },
    "title": { "type": "string" },
    "position": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" }
      }
    },
    "contextMode": {
      "type": "string",
      "enum": ["inherit", "explicit", "isolated"],
      "default": "explicit"
    },
    "fileScope": {
      "type": "object",
      "properties": {
        "allow": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      },
      "default": { "allow": [], "deny": [] }
    },
    "toolPolicy": {
      "type": "object",
      "properties": {
        "tools": { "type": "array", "items": { "type": "string" } },
        "deny": { "type": "array", "items": { "type": "string" } }
      },
      "default": { "tools": [], "deny": [] }
    },
    "memoryRef": { "type": "string" },
    "systemPrompt": { "type": "string" },
    "parentId": { "type": "string" },
    "data": {
      "type": "object",
      "properties": {
        "inputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataPort" }
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/dataPort" }
        }
      },
      "additionalProperties": true
    },
    "summary": { "type": "string" },
    "purpose": { "type": "string" },
    "output": { "type": "string" },
    "runHistory": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "startedAt", "status"],
        "properties": {
          "id": { "type": "string" },
          "startedAt": { "type": "string" },
          "finishedAt": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["running", "done", "error", "cancelled"]
          },
          "provider": { "type": "string" },
          "model": { "type": "string" },
          "inputTokens": { "type": "integer" },
          "outputTokens": { "type": "integer" },
          "error": { "type": "string" },
          "changedFiles": {
            "type": "array",
            "items": { "type": "string" }
          },
          "diff": { "type": "string" },
          "diffTruncated": { "type": "boolean" },
          "diffWarnings": {
            "type": "array",
            "items": { "type": "string" }
          },
          "toolTrace": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "step", "tool", "status", "startedAt", "input"],
              "properties": {
                "id": { "type": "string" },
                "step": { "type": "integer" },
                "tool": {
                  "type": "string",
                  "enum": ["list_files", "read_file", "grep", "apply_patch", "get_diff", "finish"]
                },
                "status": {
                  "type": "string",
                  "enum": ["running", "done", "error"]
                },
                "startedAt": { "type": "string" },
                "finishedAt": { "type": "string" },
                "input": { "type": "object" },
                "outputSummary": { "type": "string" },
                "error": { "type": "string" },
                "affectedFiles": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            },
            "default": []
          }
        }
      },
      "default": []
    },
    "resourceRefs": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    },
    "metadata": {
      "type": "object",
      "default": {}
    }
  },
  "$defs": {
    "dataPort": {
      "type": "object",
      "required": ["id", "name", "type"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["spline", "point", "polygon", "bounds", "graph", "debug", "asset", "unknown"]
        }
      }
    }
  }
}
